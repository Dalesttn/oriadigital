# ─── Site ────────────────────────────────────────────────────────────────────
# Canonical origin, no trailing slash. Everything SEO — canonicals, sitemap,
# JSON-LD, Open Graph — is built from this, so it must be the live domain.
NEXT_PUBLIC_SITE_URL=https://oriadigital.com.au

# ─── Analytics ───────────────────────────────────────────────────────────────
# GA4 measurement ID. Leave empty to ship without analytics.
NEXT_PUBLIC_GA4_ID=
# Google Search Console HTML-tag verification token (the content= value only).
NEXT_PUBLIC_GSC_VERIFICATION=

# ─── Contact form: enquiry storage (Supabase) ────────────────────────────────
# Service-role key is server-only. Never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Contact form: notification email (Resend) ───────────────────────────────
RESEND_API_KEY=
# Must be a verified sender on your Resend domain.
CONTACT_FROM_EMAIL=Oria Digital <info@oriadigital.com.au>
# Where enquiries are delivered. Defaults to site.contact.email if unset.
CONTACT_NOTIFY_EMAIL=
